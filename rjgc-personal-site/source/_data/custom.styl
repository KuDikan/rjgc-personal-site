// 数据面板样式（papers / rss / status / wiki 四个页面）
//
// 由 ShokaX 的 before_generate 自动加载：主题会检测 source/_data/custom.styl
// 是否存在，存在则追加到页面样式末尾，因此这里的规则可以覆盖主题默认样式。
//
// 注意：文件内容是 Stylus（.styl），不是 CSS。

// ---------- 通用面板 ----------
.data-panel
  margin 1.5em 0

.panel-count
  display inline-block
  margin-left .5em
  padding .1em .6em
  border-radius 1em
  font-size .7em
  font-weight 400
  vertical-align middle
  color var(--theme-color, #49b1ab)
  background rgba(73, 177, 171, .12)

.panel-block
  margin-top 1.5em

.panel-note
  margin-top 1em
  padding-top .8em
  border-top 1px solid var(--grey-4, #eee)
  font-size .78em
  line-height 1.6
  color var(--grey-6, #888)

// 数据缺失时的提示
.data-empty
  padding 1.2em
  border 1px dashed var(--grey-4, #ddd)
  border-radius 6px
  font-size .85em
  color var(--grey-6, #888)
  text-align center

  code
    padding .1em .4em
    border-radius 3px
    font-size .9em
    background var(--grey-3, #f5f5f5)

// ---------- 右下角悬浮音乐播放器 ----------
// 主题自带的 {% media %} 播放器是正文内联(position: relative)的，
// 而这里要的是右下角固定悬浮，故自行实现，用 fixed 定位。
.mp-dock
  position fixed
  right 1.5rem
  bottom 1.5rem
  z-index $zindex-4
  display flex
  flex-direction column
  align-items flex-end
  gap .6rem
  font-size .875rem

  &[hidden]
    display none

  // 折叠时只露出圆形按钮
  .mp-panel
    width 0
    height 0
    overflow hidden
    opacity 0
    transform translateY(1rem) scale(.96)
    transition width .28s ease, height .28s ease, opacity .2s ease, transform .28s ease

  &.is-open
    .mp-panel
      width 20rem
      height auto
      max-height 70vh
      opacity 1
      transform none

  // 圆形展开按钮
  .mp-toggle
    position relative
    width 3rem
    height 3rem
    border-radius 50%
    border 1px solid var(--grey-4, #ddd)
    background var(--nav-bg, #fff)
    color var(--text-color, #333)
    font-size 1.1rem
    cursor pointer
    display flex
    align-items center
    justify-content center
    box-shadow 0 4px 16px rgba(0, 0, 0, .12)
    transition transform .2s, border-color .2s, color .2s

    &:hover
      transform scale(1.06)
      border-color var(--theme-color, #49b1ab)
      color var(--theme-color, #49b1ab)

  // 播放中时按钮呼吸
  &.is-playing .mp-toggle
    border-color var(--theme-color, #49b1ab)
    color var(--theme-color, #49b1ab)
    animation mp-breathe 2.4s ease-in-out infinite

  .mp-badge
    position absolute
    top -.4rem
    right -.4rem
    min-width 1.15rem
    height 1.15rem
    padding 0 .25rem
    border-radius .6rem
    background var(--theme-color, #49b1ab)
    color #fff
    font-size .62rem
    line-height 1.15rem
    text-align center

    &[hidden]
      display none

  // 面板主体
  .mp-panel
    width 20rem
    border-radius .75rem
    border 1px solid var(--grey-4, #ddd)
    background var(--nav-bg, #fff)
    box-shadow 0 8px 32px rgba(0, 0, 0, .14)
    overflow hidden auto

  .mp-now
    display flex
    align-items center
    gap .6rem
    padding .7rem .8rem
    border-bottom 1px solid var(--grey-4, #eee)

  .mp-meta
    flex 1
    min-width 0

  .mp-title
    display block
    font-weight 600
    font-size .9rem
    white-space nowrap
    overflow hidden
    text-overflow ellipsis

  .mp-artist
    display block
    font-size .75rem
    color var(--grey-6, #888)
    white-space nowrap
    overflow hidden
    text-overflow ellipsis

  .mp-fold
    flex-shrink 0
    border 0
    background transparent
    color var(--grey-6, #888)
    cursor pointer
    font-size 1rem
    padding .2rem .3rem

    &:hover
      color var(--theme-color, #49b1ab)

  // 进度条
  .mp-progress
    display flex
    align-items center
    gap .5rem
    padding .5rem .8rem

  .mp-time
    flex-shrink 0
    font-size .7rem
    color var(--grey-6, #888)
    font-variant-numeric tabular-nums

  .mp-range
    flex 1
    height .25rem
    appearance none
    background var(--grey-4, #ddd)
    border-radius .2rem
    outline none

    &::-webkit-slider-thumb
      appearance none
      width .7rem
      height .7rem
      border-radius 50%
      background var(--theme-color, #49b1ab)
      cursor pointer

    &::-moz-range-thumb
      width .7rem
      height .7rem
      border 0
      border-radius 50%
      background var(--theme-color, #49b1ab)
      cursor pointer

  // 控制按钮
  .mp-controls
    display flex
    align-items center
    gap .4rem
    padding 0 .8rem .6rem

    button
      border 0
      background transparent
      color var(--text-color, #333)
      cursor pointer
      font-size .95rem
      padding .25rem
      border-radius 50%
      transition color .2s, background .2s

      &:hover
        color var(--theme-color, #49b1ab)
        background var(--grey-3, #f5f5f5)

  .mp-play
    background var(--theme-color, #49b1ab) !important
    color #fff !important

    &:hover
      background var(--theme-color, #49b1ab) !important
      opacity .85

  .mp-vol
    display flex
    align-items center
    gap .3rem
    margin-left auto
    color var(--grey-6, #888)
    font-size .85rem

    input
      width 3.5rem
      height .2rem
      appearance none
      background var(--grey-4, #ddd)
      border-radius .2rem
      outline none

      &::-webkit-slider-thumb
        appearance none
        width .55rem
        height .55rem
        border-radius 50%
        background var(--theme-color, #49b1ab)
        cursor pointer

      &::-moz-range-thumb
        width .55rem
        height .55rem
        border 0
        border-radius 50%
        background var(--theme-color, #49b1ab)
        cursor pointer

  // 播放列表
  .mp-list
    margin 0
    padding .3rem
    list-style none
    max-height 16rem
    overflow auto
    border-top 1px solid var(--grey-4, #eee)

  .mp-item-btn
    display block
    width 100%
    text-align left
    border 0
    background transparent
    cursor pointer
    padding .45rem .55rem
    border-radius .4rem
    transition background .15s

    &:hover
      background var(--grey-3, #f5f5f5)

  .mp-item.is-active .mp-item-btn
    background rgba(73, 177, 171, .12)

  .mp-item-title
    display block
    font-size .82rem
    color var(--text-color, #333)
    white-space nowrap
    overflow hidden
    text-overflow ellipsis

  .mp-item-artist
    display block
    font-size .7rem
    color var(--grey-6, #888)
    white-space nowrap
    overflow hidden
    text-overflow ellipsis

// ---------- 字体 ----------
//
// 站点大标题用 Yozai Medium，正文（body）用 LXGW WenKai Medium，
// 均来自 ZeoSeven 的 cn-font-split 分片服务：
//   https://fontsapi.zeoseven.com/192/medium/result.css  → Yozai Medium
//   https://fontsapi.zeoseven.com/292/medium/result.css  → LXGW WenKai Medium
// @font-face 声明见 tools/font-inject.js（注入到页面 <head>）。
//
// 分片服务按 unicode-range 切片，单个分片约 5 KB，
// 浏览器只下载页面实际用到的区间，不会拉整个字体。
//
// ---------- 首页大标题（#brand） ----------
//
// 提高选择器优先级的原因：主题的 brand.styl 里也有 `#brand .artboard`，
// 而 custom.styl 是被**追加**到主题样式之前的，同优先级下
// 主题那条（font-size: 3em / 系统字体栈）会覆盖我们。
// 用 `#brand .logo .artboard` 多一层 class 稳定压过。
//
// font-family 直接写字体名而**不用 $font-family-logo 变量**：
// 变量展开后会与主题的 font.logo.family 拼接成
//   "Yozai Medium", "Yozai Medium", serif
// 这种重复项（主题变量本身已包含我们配的值）。直接写字体名更干净，
// 字体加载失败时由后面的系统字体栈兜底。
//
// 主题变量有个 bug（_variables.styl 第 15 行）：
//     $font-family-logo = get_font_family('logo'), ... if get_font_family('title')
// 条件用的是 title 而非 logo，所以**只设 logo.family 不设 title.family
// 不会生效**。因此两个都要在 _config.shokax.yml 里写（正文 global 同理）。

#brand
  .logo .artboard
    font-family "Yozai Medium", "Optima", "Palatino Linotype", "Songti SC", serif
    font-size 3.4em
    font-weight 500
    letter-spacing .06em
    line-height 1.25
    color var(--theme-color, #49b1ab)
    text-shadow 0 2px 12px rgba(0, 0, 0, .06)

  .logo h1.title
    font-family "LXGW WenKai Medium", "Optima", "Palatino Linotype", "Songti SC", serif
    font-size 2.5em
    font-weight 500
    letter-spacing .18em
    line-height 1.3

  .meta
    font-size .875em
    letter-spacing .04em

// ---------- 搜索 ----------
// 主题的 search.styl 用 `display: none` 控制显隐（它靠 transition 库切换），
// 而本地搜索是自己 add('show')，所以这里必须显式覆盖 display。
// 另外主题把输入框样式挂在 .search-input-container > form 下，
// 而我们的输入框是 .header 的直接子元素，需要单独给 flex-grow。
#search
  display none

  &.show
    display block

    >.inner
      .header
        .search-input
          flex-grow 1

  #search-stats
    margin-bottom .75rem
    font-size .8rem
    color var(--grey-6, #888)

  #search-hits
    max-height calc(100vh - 12rem)

    .item
      padding .7em 0
      border-bottom .0625rem dashed var(--grey-4, #eee)

      &:last-child
        border-bottom none

      a
        display block
        color var(--text-color, inherit)
        the-transition()

        &:hover
          color var(--theme-color, #49b1ab)
          border-bottom-color var(--theme-color, #49b1ab)

        span
          font-size 70%
          display block
          color var(--grey-6, #888)

          i
            color var(--grey-4, #bbb)
            margin 0 .3125rem

    mark
      padding 0 .15em
      border-radius 2px
      color inherit
      background rgba(255, 214, 0, .4)

  #hits-empty
    padding 1.2em 0
    color var(--grey-6, #888)
    text-align center

// ---------- 双向链接与失效链接 ----------
.wiki-link
  color var(--theme-color, #49b1ab)
  border-bottom 1px dotted rgba(73, 177, 171, .5)
  transition border-color .2s, background .2s

  &:hover
    border-bottom-style solid
    border-bottom-color var(--theme-color, #49b1ab)
    background rgba(73, 177, 171, .08)

// 匹配不到页面时保留可见文本并标注，避免静默消失
.wiki-missing
  padding 0 .2em
  border-bottom 1px dashed var(--grey-5, #bbb)
  color var(--grey-6, #888)
  cursor help
  text-decoration none

// ---------- 搜索结果 ----------
#search-hits
  mark
    padding 0 .15em
    border-radius 2px
    color inherit
    background rgba(255, 214, 0, .35)

  .item
    padding .6em 0

#hits-empty
  padding 1.2em 0
  color var(--grey-6, #888)
  text-align center

// ---------- 状态面板 ----------
.stat-grid
  display grid
  grid-template-columns repeat(auto-fill, minmax(120px, 1fr))
  gap .8em
  margin 0
  padding 0
  list-style none

.stat
  margin 0

.stat-body
  display block
  padding 1em .6em
  border 1px solid var(--grey-4, #eee)
  border-radius 8px
  text-align center
  color inherit
  transition border-color .2s, transform .2s

  &:hover
    border-color var(--theme-color, #49b1ab)
    transform translateY(-2px)

.stat-value
  display block
  font-size 1.6em
  font-weight 600
  line-height 1.2
  color var(--theme-color, #49b1ab)

.stat-label
  display block
  margin-top .3em
  font-size .75em
  color var(--grey-6, #888)

// 技术栈表格
.stack-list
  display grid
  grid-template-columns repeat(auto-fill, minmax(220px, 1fr))
  gap .4em .8em
  margin-top .8em

.stack-row
  display flex
  justify-content space-between
  gap .8em
  padding .45em .7em
  border-radius 5px
  font-size .82em
  background var(--grey-3, #f7f7f7)

.stack-key
  color var(--grey-6, #888)
  font-family monospace

.stack-val
  font-weight 600
  text-align right

// ---------- 论文列表 ----------
.paper-list
  margin 0
  padding 0
  list-style none

.paper
  padding 1.1em 0
  border-bottom 1px solid var(--grey-4, #eee)

  &:last-child
    border-bottom none

.paper-title
  font-size 1.02em
  font-weight 600
  line-height 1.5
  color var(--theme-color, #49b1ab)

.paper-meta
  display flex
  flex-wrap wrap
  gap .8em
  margin-top .45em
  font-size .74em
  color var(--grey-6, #888)

.paper-id
  font-family monospace

.paper-abstract
  margin-top .6em
  font-size .85em
  line-height 1.7
  color var(--grey-7, #666)

// ---------- 外部订阅 ----------
.feed-group
  margin-top 1.6em

  &:first-child
    margin-top 0

.rss-list
  margin .6em 0 0
  padding 0
  list-style none

.rss-item
  padding .8em 0
  border-bottom 1px dashed var(--grey-4, #eee)

  &:last-child
    border-bottom none

.rss-link
  font-size .95em
  font-weight 600
  color var(--theme-color, #49b1ab)

.rss-date
  display block
  margin-top .25em
  font-size .72em
  color var(--grey-6, #888)

.rss-summary
  margin-top .45em
  font-size .84em
  line-height 1.7
  color var(--grey-7, #666)

// ---------- Wiki 索引 ----------
.wiki-list
  margin 0
  padding 0
  list-style none

.wiki-entry
  display flex
  align-items baseline
  justify-content space-between
  gap 1em
  padding .75em 0
  border-bottom 1px solid var(--grey-4, #eee)

  &:last-child
    border-bottom none

  a
    font-size .96em
    font-weight 600
    color var(--theme-color, #49b1ab)

.wiki-updated
  flex-shrink 0
  font-size .72em
  color var(--grey-6, #888)

// ---------- 窄屏适配 ----------
@media (max-width: 600px)
  .stat-grid
    grid-template-columns repeat(2, 1fr)

  .wiki-entry
    flex-direction column
    gap .2em
// 播放中按钮的呼吸动画（放在文件末尾以便Stylus 变量可见）
@keyframes mp-breathe
  0%, 100%
    box-shadow 0 4px 16px rgba(0, 0, 0, .12)
  50%
    box-shadow 0 4px 22px rgba(73, 177, 171, .45)

// 窄屏：面板收窄，避免遮挡内容
@media (max-width: 480px)
  .mp-dock
    right .8rem
    bottom .8rem

    &.is-open .mp-panel
      width calc(100vw - 2rem)
