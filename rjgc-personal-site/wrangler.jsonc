{
  // Cloudflare Workers —— 仅托管静态资源（无 Worker 脚本、无 SSR）
  // wrangler.jsonc 支持注释，故使用 jsonc 而非 json
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rjgc-personal-site",
  "compatibility_date": "2026-01-15",

  "assets": {
    "directory": "./public",
    // 默认即 "none"，此处显式写出：命中不到资源时若存在 public/404.html 则返回它。
    // 切勿改成 "single-page-application" —— 本站是多页结构，
    // 那样会把所有 404 回退到 index.html，导致各分区链接错乱。
    "not_found_handling": "none",
    // 配合 Hexo 默认 permalink（:title/，产出 <slug>/index.html）
    // 若改动 _config.yml 的 permalink，必须同步调整此项，否则全站 404
    "html_handling": "auto-trailing-slash"
  },

  "observability": {
    "enabled": true
  },

  // 不在此处声明 routes/自定义域名。
  //
  // 域名 personal-blog.kukuku.icu 改由 Cloudflare 控制台的
  // **Workers Routes** 接管（Workers & Pages → rjgc-personal-site
  //   → Settings → Domains & Routes → Workers Routes）。
  //
  // 为什么从 wrangler.jsonc 里移除：声明式 custom_domain 会让 wrangler
  // 在每次 deploy 时调用 /accounts/*/workers/scripts/*/domains/records，
  // 该接口对当前 token 会报 "partially updated" 导致 CI 部署步骤变红
  // （资产其实已上传成功）。交给控制台的 Workers Routes 后，
  // wrangler 不再碰域名绑定，deploy 只做资产上传。
  //
  // 注意：一旦配置 routes，wrangler 会默认关闭 workers.dev，
  // 所以这里显式保持开启——CI 冒烟测试优先用 wrangler 返回的
  // deployment-url（workers.dev），为空时才回退到自定义域名。
  // 若你只想保留自定义域名、不暴露 workers.dev，改为 false 即可，
  // 同时需把 CI 冒烟测试的 fallback 保留为 personal-blog.kukuku.icu。
  "workers_dev": true
}